+"""Concrete transport and SDK errors shared by LLM consumers."""
+
+import httpx
+import openai
+
+LLM_ERRORS: tuple[type[Exception], ...] = (openai.APIError, httpx.HTTPError)
+
+# Anthropic is optional in the core installation.
+try:
+    import anthropic
+except ImportError:
+    pass
+else:
+    LLM_ERRORS += (anthropic.APIError,)
